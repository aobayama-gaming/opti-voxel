{
    "comment": "Example climate (src/climate.cpp describes the format). Tuned for 5 cm voxels and the default 15 LODs (octaves up to 26 km); it stays varied at 25 LODs (the lapse is weak: the ground there sits kilometres above the datum).",
    "fields": [
        {
            "name": "temperature",
            "bands": [{ "from_m": 3200, "to_m": 26000, "amp": 0.8, "persistence": 0.7 }],
            "terms": [{ "source": "ground", "per_m": -0.00003 }]
        },
        {
            "name": "humidity",
            "bands": [{ "from_m": 1600, "to_m": 26000, "amp": 0.8, "persistence": 0.7 }]
        },
        {
            "name": "variant",
            "bands": [{ "from_m": 400, "to_m": 6500, "amp": 0.6, "persistence": 0.7 }]
        }
    ],
    "biomes": [
        {
            "name": "volcanic",
            "where": [{ "field": "temperature", "min": 0.45, "fade": 0.1 }, { "field": "variant", "min": 0.25, "fade": 0.1 }],
            "amp": [{ "field": "ground", "from_m": 1000, "to_m": 6500, "x": 2 }],
            "surface": { "flat": "#2c2622", "steep": "#1a1614", "roughness": 0.9 },
            "debug_color": "#c03818"
        },
        {
            "name": "tundra",
            "where": [{ "field": "temperature", "max": -0.4, "fade": 0.1 }],
            "amp": [{ "field": "ground", "from_m": 50, "to_m": 400, "x": 0.5 }],
            "surface": { "flat": "#e4ecf0", "steep": "#70747a", "roughness": 0.7 },
            "debug_color": "#d8e4ec"
        },
        {
            "name": "desert",
            "where": [{ "field": "temperature", "min": 0.15, "fade": 0.1 }, { "field": "humidity", "max": -0.25, "fade": 0.1 }],
            "amp": [{ "field": "ground", "from_m": 100, "to_m": 2000, "x": 0.1 }],
            "surface": { "flat": "#d8b878", "steep": "#a8703c" },
            "debug_color": "#e0c070"
        },
        {
            "name": "mountains",
            "where": [{ "field": "variant", "min": 0.35, "fade": 0.15 }],
            "amp": [{ "field": "ground", "from_m": 1000, "to_m": 13000, "x": 2 }],
            "surface": { "flat": "#8c867c", "steep": "#5c564e" },
            "debug_color": "#7a6a5a"
        },
        {
            "name": "swamp",
            "where": [{ "field": "humidity", "min": 0.35, "fade": 0.1 }],
            "amp": [{ "field": "ground", "from_m": 50, "to_m": 6500, "x": 0.05 }],
            "surface": { "flat": "#4a5428", "steep": "#3c3424", "roughness": 0.6 },
            "debug_color": "#4a6040"
        },
        {
            "name": "forest",
            "where": [{ "field": "humidity", "min": 0.05, "fade": 0.15 }],
            "surface": { "flat": "#2c5a1c", "steep": "#4c4234" },
            "debug_color": "#2f7a30"
        },
        {
            "name": "plain",
            "amp": [{ "field": "ground", "from_m": 1000, "to_m": 26000, "x": 0.1 }],
            "surface": { "flat": "#82a440", "steep": "#6c5c44" },
            "debug_color": "#9cc060"
        }
    ]
}
