{
    "comment": "Example climate (src/climate_parse.cpp describes the format). Tuned for 5 cm voxels at any LOD count: ranges keep the octaves the ground has (up to 26 km at 15 LODs, 26,000 km at 25). Each field has local octaves (km) and continental ones, so every ground octave has a biome map at its own scale, and every biome shapes the whole spectrum: amplitudes past the ground's 3.3 km cap can only go down.",
    "fields": [
        {
            "name": "temperature",
            "bands": [
                { "from_m": 3200, "to_m": 26000, "amp": 0.5, "persistence": 0.7 },
                { "from_m": 52000, "to_m": 30000000, "amp": 0.35 }
            ],
            "terms": [{ "source": "ground", "per_m": -0.00003 }]
        },
        {
            "name": "humidity",
            "bands": [
                { "from_m": 1600, "to_m": 26000, "amp": 0.5, "persistence": 0.7 },
                { "from_m": 52000, "to_m": 30000000, "amp": 0.35 }
            ]
        },
        {
            "name": "variant",
            "bands": [
                { "from_m": 400, "to_m": 6500, "amp": 0.35, "persistence": 0.7 },
                { "from_m": 13000, "to_m": 30000000, "amp": 0.2 }
            ]
        }
    ],
    "biomes": [
        {
            "name": "volcanic",
            "where": [{ "field": "temperature", "min": 0.3, "fade": 0.08 }, { "field": "variant", "min": 0.25, "fade": 0.1 }],
            "amp": [
                { "field": "ground", "from_m": 0.4, "to_m": 25, "x": 1.5 },
                { "field": "ground", "from_m": 50, "to_m": 13000, "x": 2 }
            ],
            "surface": { "flat": "#2c2622", "steep": "#1a1614", "roughness": 0.9 },
            "debug_color": "#c03818"
        },
        {
            "name": "tundra",
            "where": [{ "field": "temperature", "max": -0.25, "fade": 0.08 }],
            "amp": [
                { "field": "ground", "from_m": 0.4, "to_m": 400, "x": 0.4 },
                { "field": "ground", "from_m": 800, "to_m": 30000000, "x": 0.6 }
            ],
            "surface": { "flat": "#e4ecf0", "steep": "#70747a", "roughness": 0.7 },
            "debug_color": "#d8e4ec"
        },
        {
            "name": "desert",
            "where": [{ "field": "temperature", "min": 0.1, "fade": 0.08 }, { "field": "humidity", "max": -0.15, "fade": 0.08 }],
            "amp": [
                { "field": "ground", "from_m": 0.4, "to_m": 25, "x": 0.15 },
                { "field": "ground", "from_m": 50, "to_m": 200, "x": 0.8 },
                { "field": "ground", "from_m": 400, "to_m": 30000000, "x": 0.12 }
            ],
            "surface": { "flat": "#d8b878", "steep": "#a8703c" },
            "debug_color": "#e0c070"
        },
        {
            "name": "mountains",
            "where": [{ "field": "variant", "min": 0.45, "fade": 0.1 }],
            "amp": [
                { "field": "ground", "from_m": 3, "to_m": 25, "x": 1.5 },
                { "field": "ground", "from_m": 50, "to_m": 6500, "x": 2.5 },
                { "field": "ground", "wavelength_m": 13000, "x": 2 }
            ],
            "surface": { "flat": "#8c867c", "steep": "#5c564e" },
            "debug_color": "#7a6a5a"
        },
        {
            "name": "swamp",
            "where": [{ "field": "humidity", "min": 0.25, "fade": 0.08 }],
            "amp": [
                { "field": "ground", "from_m": 0.4, "to_m": 3, "x": 0.4 },
                { "field": "ground", "from_m": 6, "to_m": 30000000, "x": 0.04 }
            ],
            "surface": { "flat": "#4a5428", "steep": "#3c3424", "roughness": 0.6 },
            "debug_color": "#4a6040"
        },
        {
            "name": "forest",
            "where": [{ "field": "humidity", "min": 0.05, "fade": 0.15 }],
            "amp": [{ "field": "ground", "from_m": 1600, "to_m": 30000000, "x": 0.6 }],
            "surface": { "flat": "#2c5a1c", "steep": "#4c4234" },
            "debug_color": "#2f7a30"
        },
        {
            "name": "plain",
            "amp": [
                { "field": "ground", "from_m": 0.4, "to_m": 12, "x": 0.3 },
                { "field": "ground", "from_m": 25, "to_m": 30000000, "x": 0.08 }
            ],
            "surface": { "flat": "#82a440", "steep": "#6c5c44" },
            "debug_color": "#9cc060"
        }
    ]
}
