{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && \"$CLAUDE_PROJECT_DIR/tools/format.sh\" \"$f\"; } 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "clang-format"
          }
        ]
      }
    ]
  }
}
